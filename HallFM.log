              # Включаем сетевые буферы и увеличиваем их количество под TCP
              CONFIG_NET_PKT_RX_COUNT=64
              CONFIG_NET_PKT_TX_COUNT=32

              CONFIG_NET_BUF_RX_COUNT=160
              CONFIG_NET_BUF_TX_COUNT=64

              CONFIG_NET_BUF_DATA_SIZE=128


              # 3. Настройка очистки памяти (КРИТИЧЕСКИ ВАЖНО)
              # Ускоряем уничтожение закрытых контекстов сокетов, чтобы память возвращалась в пул мгновенно
              CONFIG_NET_TCP_TIME_WAIT_DELAY=500

              # 4. Включаем автоматический сброс при нехватке памяти (если стек поддерживает)
              CONFIG_NET_STATISTICS=y