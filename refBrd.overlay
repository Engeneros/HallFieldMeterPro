/* === НАСТРОЙКА ПЕРИФЕРИИ И КОНСОЛИ === */

/* 1. Настраиваем мультиплексирование ножек (Pin Control) */
&pinctrl {
    usart1_tx_pa9: usart1_tx_pa9 {
        pinmux = <STM32_PINMUX('A', 9, AF7)>; /* PA9 как Alternate Function 7 (UART1_TX) */
    };
    usart1_rx_pa10: usart1_rx_pa10 {
        pinmux = <STM32_PINMUX('A', 10, AF7)>; /* PA10 как AF7 (UART1_RX) */
        bias-pull-up; /* Включаем подтяжку для линии RX */
    };
};

/* 2. Активируем сам UART1 и привязываем к нему пины */
&usart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
};

/* 3. Говорим Zephyr, что этот UART должен использоваться для консоли (printk) */
/ {
    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
    };
};



/* Включаем DMA1, так как SPI2 работает через него */
&dma1 {
	status = "okay";
};

&pinctrl {
    /* Создаем ТРИ отдельных узла для SPI2 */
    spi2_sck_custom: spi2_sck_custom {
        pinmux = <STM32_PINMUX('C', 2, AF5)>;
        drive-push-pull;
        slew-rate = "very-high-speed";
    };
    spi2_miso_custom: spi2_miso_custom {
        pinmux = <STM32_PINMUX('B', 10, AF5)>;
        drive-push-pull;
        slew-rate = "very-high-speed";
    };
    spi2_mosi_custom: spi2_mosi_custom {
        pinmux = <STM32_PINMUX('C', 3, AF5)>;
        drive-push-pull;
        slew-rate = "very-high-speed";
    };
};


&spi2 {
    status = "okay";
    /* Ссылаемся на все три созданных узла через пробел */
    pinctrl-0 = <&spi2_sck_custom &spi2_miso_custom &spi2_mosi_custom>;
    pinctrl-names = "default";
    
    /* DMA1 для SPI2 на F7: TX - Stream 4, RX - Stream 3, Channel 0 */
    dmas = <&dma1 4 0 0x400 0x0>,
           <&dma1 3 0 0x400 0x0>;
    dma-names = "tx", "rx";

    slow_spi_dev2: spi-device@0 {
        compatible = "vnd,spi-device";
        reg = <0>;
        spi-max-frequency = <1000000>;
    };
};

/* 1. Убеждаемся, что контроллер порта G включен */
&gpiog {
	status = "okay";
};

/ {
	 //Имя контейнера делаем тоже понятным и без префикса "my" 
	status_leds {
		compatible = "gpio-leds";

		led_green: led-green {
//			gpios = <&gpiog 0 GPIO_ACTIVE_HIGH>;
			gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
			label = "LED GREEN";
		};

		led_red: led-red {
//			gpios = <&gpiog 1 GPIO_ACTIVE_HIGH>;
			gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;
			label = "LED RED";
		};
		
		led_blue: led-blue {
//			gpios = <&gpiog 3 GPIO_ACTIVE_HIGH>;
			gpios = <&gpiob 14 GPIO_ACTIVE_HIGH>;
			label = "LED BLUE";
		};
	};
};

