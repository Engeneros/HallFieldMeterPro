/* === ОФИЦИАЛЬНАЯ НАСТРОЙКА ETHERNET ДЛЯ NUCLEO-F756ZG === */
&pinctrl {
	/* Используем стандартные пины Nucleo, обратите внимание на PA7 */
	my_eth_ref_clk: my_eth_ref_clk { pinmux = <STM32_PINMUX('A', 1, AF11)>; };
	my_eth_mdio: my_eth_mdio { pinmux = <STM32_PINMUX('A', 2, AF11)>; };
	my_eth_crs_dv: my_eth_crs_dv { pinmux = <STM32_PINMUX('A', 7, AF11)>; }; /* На Nucleo это PA7! */
	my_eth_mdc: my_eth_mdc { pinmux = <STM32_PINMUX('C', 1, AF11)>; };
	my_eth_rxd0: my_eth_rxd0 { pinmux = <STM32_PINMUX('C', 4, AF11)>; };
	my_eth_rxd1: my_eth_rxd1 { pinmux = <STM32_PINMUX('C', 5, AF11)>; };
	my_eth_tx_en: my_eth_tx_en { pinmux = <STM32_PINMUX('G', 11, AF11)>; };
	my_eth_txd0: my_eth_txd0 { pinmux = <STM32_PINMUX('G', 13, AF11)>; };
	my_eth_txd1: my_eth_txd1 { pinmux = <STM32_PINMUX('B', 13, AF11)>; };
};

&mac {
	status = "okay";
	pinctrl-0 = <&my_eth_ref_clk &my_eth_crs_dv &my_eth_rxd0 &my_eth_rxd1 &my_eth_tx_en &my_eth_txd0 &my_eth_txd1>;
	pinctrl-names = "default";

	mdio {
		compatible = "st,stm32-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
		pinctrl-0 = <&my_eth_mdio &my_eth_mdc>;
		pinctrl-names = "default";

		/* Прописываем PHY на адрес 0, который использует Nucleo */
		ethernet_phy: ethernet-phy@0 {
			compatible = "ethernet-phy";
			reg = <0>;
			status = "okay";
		};
	};
};

/* Активируем встроенный аппаратный генератор случайных чисел */
&rng {
	status = "okay";
};


/* Объявляем Modbus TCP сервер на уровне Devicetree */
/ {
	modbus_tcp_server: modbus_tcp_server {
		compatible = "zephyr,modbus-server";
		status = "okay";
	};
};
