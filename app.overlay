#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
/////////-----------UART4.1952---------

/////////-----------UART4.1952---------
/* app.overlay */

/* === НАСТРОЙКА ТАКТИРОВАНИЯ (ПОД КВАРЦ 4.9152 МГц) === */
&clk_hse {
    clock-frequency = <4915200>;
    status = "okay";
};

&pll {
    div-m = <4>;           /* 4.9152 / 4 = 1.2288 MHz */
    mul-n = <320>;         /* 1.2288 * 320 = 393.216 MHz */
    div-p = <2>;           /* 393.216 / 2 = 196.608 MHz (SYSCLK) */
    div-q = <8>;           /* Значение для USB (не используется) */

    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <196608000>; /* Итоговый SYSCLK */

    ahb-prescaler = <1>;   /* HCLK = 196.608 MHz */
    apb1-prescaler = <4>;  /* PCLK1 = 49.152 MHz */
    apb2-prescaler = <2>;  /* PCLK2 = 98.304 MHz (Тактирует ваш USART1) */
};


// === НАСТРОЙКА ПЕРИФЕРИИ И КОНСОЛИ ===

// 1. Настраиваем мультиплексирование ножек (Pin Control)
&pinctrl {
    usart1_tx_pa9: usart1_tx_pa9 {
        pinmux = <STM32_PINMUX('A', 9, AF7)>; /* PA9 как Alternate Function 7 (UART1_TX) */
    };
    usart1_rx_pa10: usart1_rx_pa10 {
        pinmux = <STM32_PINMUX('A', 10, AF7)>; /* PA10 как AF7 (UART1_RX) */
        bias-pull-up; /* Включаем подтяжку для линии RX */
    };
};

/* 2. Активируем сам UART1 и привязываем к нему пины */
&usart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
};

/* 3. Говорим Zephyr, что этот UART должен использоваться для консоли (printk) */
/ {
    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
    };
};
////////////////////////////////////////////

/* Включаем DMA1 — он не помешает, так как в &spi2 мы его не привязываем */

&dma1 {
	status = "okay";
};

/* Дописываем пины ВНУТРЬ системного контроллера pinctrl */
&pinctrl {
    /* Плоский узел для тактового сигнала */
    spi2_sck_pb10: spi2_sck_pb10 {
        pinmux = <STM32_PINMUX('B', 10, AF5)>;
        drive-push-pull;
	bias-pull-down;
        slew-rate = "very-high-speed";
    };

    /* Плоский узел для входа данных (MISO) */
    spi2_miso_pc2: spi2_miso_pc2 {
        pinmux = <STM32_PINMUX('C', 2, AF5)>;
        bias-disable; /* Для входа MISO лучше выключить push-pull */
    };

    /* Плоский узел для выхода данных (MOSI) */
    spi2_mosi_pc3: spi2_mosi_pc3 {
        pinmux = <STM32_PINMUX('C', 3, AF5)>;
        drive-push-pull;
        slew-rate = "very-high-speed";
    };
};

&spi2 {
	status = "okay";

	/* МАГИЯ ЗДЕСЬ: Перечисляем все три кастомных узла через пробел! */
	/* Zephyr инициализирует их одновременно для одной шины SPI2 */
	pinctrl-0 = <&spi2_sck_pb10 &spi2_miso_pc2 &spi2_mosi_pc3>;
	pinctrl-names = "default";

	/* Ваш кастомный пин CS. Укажите ваш реальный порт/номер ножки */
	cs-gpios = <&gpiof 11 GPIO_ACTIVE_LOW>;

	ads1234_spi: ads1234_spi@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

//
