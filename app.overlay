#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
/////////-----------UART4.1952---------

/////////-----------UART4.1952---------
/* app.overlay */

/* === НАСТРОЙКА ТАКТИРОВАНИЯ (ПОД КВАРЦ 4.9152 МГц) === */
&clk_hse {
    clock-frequency = <4915200>;
    status = "okay";
};

&pll {
    div-m = <4>;           /* 4.9152 / 4 = 1.2288 MHz */
    mul-n = <320>;         /* 1.2288 * 320 = 393.216 MHz */
    div-p = <2>;           /* 393.216 / 2 = 196.608 MHz (SYSCLK) */
    div-q = <8>;           /* Значение для USB (не используется) */

    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <196608000>; /* Итоговый SYSCLK */

    ahb-prescaler = <1>;   /* HCLK = 196.608 MHz */
    apb1-prescaler = <4>;  /* PCLK1 = 49.152 MHz */
    apb2-prescaler = <2>;  /* PCLK2 = 98.304 MHz (Тактирует ваш USART1) */
};


// === НАСТРОЙКА ПЕРИФЕРИИ И КОНСОЛИ ===

// 1. Настраиваем мультиплексирование ножек (Pin Control)
&pinctrl {
    usart1_tx_pa9: usart1_tx_pa9 {
        pinmux = <STM32_PINMUX('A', 9, AF7)>; /* PA9 как Alternate Function 7 (UART1_TX) */
    };
    usart1_rx_pa10: usart1_rx_pa10 {
        pinmux = <STM32_PINMUX('A', 10, AF7)>; /* PA10 как AF7 (UART1_RX) */
        bias-pull-up; /* Включаем подтяжку для линии RX */
    };
};

/* 2. Активируем сам UART1 и привязываем к нему пины */
&usart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
};

/* 3. Говорим Zephyr, что этот UART должен использоваться для консоли (printk) */
/ {
    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
    };
};
////////////////////////////////////////////

/* Включаем DMA1 — он не помешает, так как в &spi2 мы его не привязываем */

&dma1 {
	status = "okay";
};

/* Дописываем пины ВНУТРЬ системного контроллера pinctrl */
&pinctrl {
    /* Плоский узел для тактового сигнала */
    spi2_sck_pb10: spi2_sck_pb10 {
        pinmux = <STM32_PINMUX('B', 10, AF5)>;
        drive-push-pull;
	bias-pull-down;
        slew-rate = "very-high-speed";
    };

    /* Плоский узел для входа данных (MISO) */
    spi2_miso_pc2: spi2_miso_pc2 {
        pinmux = <STM32_PINMUX('C', 2, AF5)>;
        bias-disable; /* Для входа MISO лучше выключить push-pull */
    };

    /* Плоский узел для выхода данных (MOSI) */
    spi2_mosi_pc3: spi2_mosi_pc3 {
        pinmux = <STM32_PINMUX('C', 3, AF5)>;
        drive-push-pull;
        slew-rate = "very-high-speed";
    };
};

&spi2 {
	status = "okay";

	/* МАГИЯ ЗДЕСЬ: Перечисляем все три кастомных узла через пробел! */
	/* Zephyr инициализирует их одновременно для одной шины SPI2 */
	pinctrl-0 = <&spi2_sck_pb10 &spi2_miso_pc2 &spi2_mosi_pc3>;
	pinctrl-names = "default";

	/* Ваш кастомный пин CS. Укажите ваш реальный порт/номер ножки */
	cs-gpios = <&gpiof 11 GPIO_ACTIVE_LOW>;

	ads1234_spi: ads1234_spi@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};


/* 1. Убеждаемся, что контроллер порта G включен */
&gpiof {
	status = "okay";
};

&gpiog {
	status = "okay";
};


/ {
	 //Имя контейнера делаем тоже понятным и без префикса "my"
	status_leds {
		compatible = "gpio-leds";

		led_green: led-green {
			gpios = <&gpiog 0 GPIO_ACTIVE_HIGH>;
//			gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
			label = "LED GREEN";
		};

		led_red: led-red {
			gpios = <&gpiog 1 GPIO_ACTIVE_HIGH>;
//			gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;
			label = "LED RED";
		};

		led_blue: led-blue {
			gpios = <&gpiog 3 GPIO_ACTIVE_HIGH>;
//			gpios = <&gpiob 14 GPIO_ACTIVE_HIGH>;
			label = "LED BLUE";
		};

        ad_mx_0: ad-mx-0 {
			gpios = <&gpiof 2 GPIO_ACTIVE_HIGH>;
			label = "ADC_MUX_A0";
		};

        ad_mx_1: ad-mx-1 {
			gpios = <&gpiof 3 GPIO_ACTIVE_HIGH>;
			label = "ADC_MUX_A1";
		};

        ad_g_0: ad-g-0 {
			gpios = <&gpiof 5 GPIO_ACTIVE_HIGH>;
			label = "ADC_GAIN_0";
		};

        ad_g_1: ad-g-1 {
			gpios = <&gpiof 4 GPIO_ACTIVE_HIGH>;
			label = "ADC_GAIN_1";
		};

        cb_mx_0: cb-mx-0 {
			gpios = <&gpiof 6 GPIO_ACTIVE_HIGH>;
			label = "CALIBR_MX_A0";
		};

        cb_mx_1: cb-mx-1 {
			gpios = <&gpiof 7 GPIO_ACTIVE_HIGH>;
			label = "CALIBR_MX_A1";
		};

        cb_mx_en: cb-mx-en {
			gpios = <&gpiof 8 GPIO_ACTIVE_HIGH>;
			label = "CALIBR_MX_EN";
		};

        ad_speed: ad-speed {
			gpios = <&gpiof 9 GPIO_ACTIVE_HIGH>;
			label = "ADC_SPEED";
		};

        ad_rst_n: ad-rst-n {
			gpios = <&gpiof 10 GPIO_ACTIVE_HIGH>;
			label = "ADC_NEG_RESET";
		};

	};
};
/* Активируем порт B микроконтроллера */
&gpiob {
	status = "okay";
};

/ {
	/* Группа для входных пинов и кнопок */
	uc_inputs {
		compatible = "gpio-keys";

		/* Имя ноды для EXTI прерывания (PB15) */
		ad_drdy: ad-drdy {
			/* Настройка: порт B, пин 15. Флаг ACTIVE_LOW означает, */
			/* что логическим считается нулевой уровень (спад) */
			gpios = <&gpiob 15 GPIO_ACTIVE_LOW>;
			label = "ADS1234 DOUT/DRDY INTERRUPT";
		};
	};
};
///---727-4
/* 1. Назначаем пины на контроллер MAC */
&mac {
	status = "okay";
	pinctrl-0 = <
		&eth_ref_clk_pa1
		&eth_mdio_pa2
		&eth_crs_dv_pa7
		&eth_mdc_pc1
		&eth_rxd0_pc4
		&eth_rxd1_pc5
		&eth_tx_en_pg11
		&eth_txd0_pg13
		&eth_txd1_pb13
	>;
	pinctrl-names = "default";

	/* 2. Настраиваем внутренний узел MDIO, не используя глобальную метку */
	mdio {
		status = "okay";
/* Явно задаем формат адресации для PHY: 1 ячейка на адрес, 0 на размер */
		#address-cells = <1>;
		#size-cells = <0>;
		ethernet-phy@0 {
			compatible = "ethernet-phy";
			reg = <0>;
		};
	};
};
/* Активируем встроенный аппаратный генератор случайных чисел */
&rng {
	status = "okay";
};

/* Объявляем Modbus TCP сервер на уровне Devicetree */
/ {
	modbus_tcp_server: modbus_tcp_server {
		compatible = "zephyr,modbus-server";
		status = "okay";
	};
};

//===========i2c==================
&i2c1 {
	status = "okay";
	/* Используем готовые константы пинов из ядра Zephyr */
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
	pinctrl-names = "default";

	/* Задаем стандартную скорость шины 100 кГц (или 400000 для Fast Mode) */
	clock-frequency = <I2C_BITRATE_STANDARD>;

	/* Объявляем вашу микросхему EEPROM */
	eeprom_at24: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;          /* Семь бит I2C-адреса чипа (обычно 0x50 для AT24) */
		size = <2048>;         /* Общий объем памяти чипа AT24C16 в байтах (16 Кбит = 2048 байт) */
		pagesize = <16>;       /* Размер страницы записи в байтах для AT24C16 */
		address-width = <8>;   /* Ширина внутреннего адреса (у AT24C16 адрес равен 8 битам) */
		timeout = <5>;         /* Тайм-аут записи чипа в миллисекундах */
	};
};




